 # read mdb.c before changing any of them.
 #
-CC	= gcc
-AR	= ar
+CC	?= gcc
+AR	?= ar
 W	= -W -Wall -Wno-unused-parameter -Wbad-function-cast -Wuninitialized
 THREADS = -pthread
 OPT = -O2 -g
